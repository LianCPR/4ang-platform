# ═══════════════════════════════════════════════════════════
# 4ANG Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to git.
# ═══════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── JWT ────────────────────────────────────────────────
# REQUIRED — generate a real secret for production
# openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me

# ─── Database ───────────────────────────────────────────
# SQLite database path (relative to server/ or absolute)
# DB_PATH=./data/app.sqlite

# ─── File Uploads ───────────────────────────────────────
# Local disk fallback when Supabase Storage is not configured
# UPLOAD_DIR=./uploads

# ─── App URL (auth redirects) ───────────────────────────
APP_URL=http://localhost:5173

# ─── Supabase (optional) ────────────────────────────────
# Leave blank to use SQLite only
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ─── OAuth (optional) ───────────────────────────────────
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
