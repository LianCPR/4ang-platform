{
  "name": "4ang",
  "private": true,
  "scripts": {
    "dev": "concurrently \"cd server && pnpm dev\" \"cd client && pnpm dev\"",
    "build": "pnpm --filter music-app build && pnpm --filter song-app-server build",
    "build:client": "cd client && pnpm build",
    "build:server": "cd server && pnpm build",
    "build:native": "cd native/audio-engine && cmake -B build && cmake --build build",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "cd tests && pnpm test:unit",
    "test:integration": "cd tests && pnpm test:integration",
    "lint": "cd client && pnpm lint",
    "typecheck": "cd client && pnpm typecheck",
    "db:migrate": "cd supabase && pnpm migrate",
    "db:seed": "cd supabase && pnpm seed",
    "clean": "rm -rf node_modules client/node_modules server/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
