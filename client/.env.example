# ─── 4ANG Client Environment ────────────────────────────────
# For Vercel, set these in Project Settings → Environment Variables.

# Backend API URL (leave empty for local dev with Vite proxy)
# In production: https://your-api-domain.com
VITE_API_URL=

# Supabase (for direct client-side operations if needed)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
