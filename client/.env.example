# ═══════════════════════════════════════════════════════════
# 4ANG Client — Environment Variables
# Copy this file to .env.local and fill in your values.
# ═══════════════════════════════════════════════════════════

# ─── API URL ────────────────────────────────────────────
# In development, Vite proxies /api to localhost:3001.
# In production (Vercel), set this to your backend URL:
VITE_API_URL=

# ─── Supabase (optional) ────────────────────────────────
# Required only if using Supabase Auth/Storage directly from frontend
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
