[TEMPLATE]
# ═══════════════════════════════════════════════════════════
# 4ANG Client — Environment Variables
# Copy this file to .env.local and fill in your values.
# ═══════════════════════════════════════════════════════════

# ─── API URL ────────────────────────────────────────────
# In development, Vite proxies /api to localhost:3001.
# In production, set this to your deployed backend URL:
#   - Vercel: set in Vercel dashboard as env var
#   - Cloudflare Pages: not needed (uses functions/api/ proxy)
VITE_API_URL=

# ─── Supabase (required for email OTP) ──────────────────
# Get from Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Google OAuth (optional) ────────────────────────────
# Only needed for "Sign in with Google" button
# VITE_GOOGLE_CLIENT_ID=

# ─── Apple OAuth (optional) ─────────────────────────────
# Only needed for "Sign in with Apple" button
# VITE_APPLE_CLIENT_ID=
